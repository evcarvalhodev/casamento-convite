{
  "cleanUrls": true,
  "trailingSlash": false,
  "rewrites": [
    { "source": "/:slug([a-z0-9]+(?:-[a-z0-9]+)*)", "destination": "/convite.html" }
  ],
  "headers": [
    { "source": "/(checkout|entrar|criar|painel|adm)", "headers": [{ "key": "X-Robots-Tag", "value": "noindex" }] },
    { "source": "/js/(.*)", "headers": [{ "key": "Cache-Control", "value": "public, max-age=300" }] }
  ]
}
